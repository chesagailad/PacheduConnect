# Production Environment Configuration Example
# Author: Gailad Chesa
# Created: 2024-01-01
# Copy this file to .env.production and update with actual values

# Server Configuration
NODE_ENV=production
PORT=5001
HOST=0.0.0.0

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pachedu_production
DB_USER=pachedu_user
DB_PASSWORD=your_secure_db_password_here
DB_DIALECT=postgres
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your_64_character_jwt_secret_here_replace_with_actual_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=pachedu-connect
JWT_AUDIENCE=pachedu-users

# Security Configuration
ENCRYPTION_KEY=your_32_character_encryption_key_here_replace_with_actual_key
MIN_PASSWORD_LENGTH=12
SESSION_TIMEOUT=86400
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=30

# PCI-DSS Compliance
PCI_DSS_COMPLIANCE=true
GDPR_COMPLIANCE=true
SOX_COMPLIANCE=true

# KYC Provider Configuration
JUMIO_API_KEY=your_jumio_api_key_here
JUMIO_API_SECRET=your_jumio_api_secret_here
ONFIDO_API_KEY=your_onfido_api_key_here
SUMSUB_API_KEY=your_sumsub_api_key_here
SUMSUB_API_SECRET=your_sumsub_api_secret_here
TRULIOO_API_KEY=your_trulioo_api_key_here

# Payment Gateway Configuration
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
OZOW_API_KEY=your_ozow_api_key_here
OZOW_SITE_CODE=your_ozow_site_code_here
PAYFAST_MERCHANT_ID=your_payfast_merchant_id_here
PAYFAST_MERCHANT_KEY=your_payfast_merchant_key_here
STITCH_CLIENT_ID=your_stitch_client_id_here
STITCH_CLIENT_SECRET=your_stitch_client_secret_here

# SMS Configuration
SMS_PROVIDER=smsportal
SMSPORTAL_API_KEY=your_smsportal_api_key_here
SMSPORTAL_CLIENT_ID=your_smsportal_client_id_here
SMSPORTAL_CLIENT_SECRET=your_smsportal_client_secret_here

# Email Configuration
EMAIL_PROVIDER=nodemailer
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password_here
EMAIL_FROM=noreply@pachedu.com

# Exchange Rate API
XE_API_KEY=your_xe_api_key_here
XE_API_URL=https://xecdapi.xe.com/v1

# Security Monitoring
SECURITY_EMAIL=security@pachedu.com
SLACK_WEBHOOK_URL=your_slack_webhook_url_here
SECURITY_SMS_NUMBER=+1234567890
SECURITY_WEBHOOK_URL=your_security_webhook_url_here

# Performance Configuration
ENABLE_CLUSTERING=true
MAX_WORKERS=4
ENABLE_CACHING=true
ENABLE_COMPRESSION=true
ENABLE_RATE_LIMITING=true

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d

# CORS Configuration
ALLOWED_ORIGINS=https://pachedu.com,https://www.pachedu.com,https://api.pachedu.com,https://admin.pachedu.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_DELAY_AFTER=50
RATE_LIMIT_DELAY_MS=500

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf
UPLOAD_PATH=uploads

# Monitoring and Analytics
ENABLE_MONITORING=true
METRICS_PORT=9090
PROMETHEUS_ENABLED=true

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# SSL/TLS Configuration
SSL_ENABLED=true
SSL_CERT_PATH=/path/to/ssl/certificate.crt
SSL_KEY_PATH=/path/to/ssl/private.key

# Session Configuration
SESSION_SECRET=your_session_secret_here
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=strict

# API Configuration
API_VERSION=v1
API_RATE_LIMIT_ENABLED=true
API_DOCUMENTATION_ENABLED=true

# Development/Testing
TEST_MODE=false
DEBUG_MODE=false
MOCK_EXTERNAL_SERVICES=false 